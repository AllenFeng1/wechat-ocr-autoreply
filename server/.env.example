# ===== LLM 配置（OpenAI 兼容接口，默认 DeepSeek）=====
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=8000

# ===== 防封号参数（可按需调整，宁紧勿松）=====
# 白名单：只处理这些会话（微信备注名/昵称，逗号分隔）；留空 = 不按白名单过滤
WHITELIST=
# 每小时最多自动回复条数
MAX_REPLIES_PER_HOUR=20
# 每天最多自动回复条数
MAX_REPLIES_PER_DAY=50
# 活跃时段（只在这段时间内自动回复，24小时制，本地时区）
ACTIVE_HOUR_START=8
ACTIVE_HOUR_END=23
# 两次回复的最小间隔（秒）
MIN_INTERVAL_SECONDS=30
# 人设/system prompt（描述你希望 AI 怎么说话）
PERSONA=你是一个随和的年轻人，说话简短自然，偶尔用口语化的表达，从不用书面腔。
